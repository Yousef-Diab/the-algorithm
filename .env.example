# Neon Postgres — project "the-algorithm", database neondb
DATABASE_URL=

# Neon Auth (managed Better Auth) — base URL from the Neon console Auth tab
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Comma-separated allowlist that bootstraps user_roles on sign-in
ADMIN_EMAILS=

# Cloudflare R2 — private bucket, no public URL
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Shared secret for POST/GET /api/revalidate — generate the same way as NEON_AUTH_COOKIE_SECRET
REVALIDATE_SECRET=

# Playwright: a dedicated second test account for the signed-in gating test.
# This account is a MEMBER with an entitlement, NOT an admin — the gating suite
# depends on it exercising the entitlement path. Never add it to ADMIN_EMAILS.
E2E_EMAIL=
E2E_PASSWORD=

# Playwright: a dedicated THIRD test account, this one an admin, for the
# admin-only half of the draft-visibility suite (an admin must still be able to
# review a draft lesson's quiz before it is published).
# Its address must ALSO be listed in ADMIN_EMAILS above — that allowlist is what
# bootstraps the user_roles row on first sign-in (lib/db/access-queries.ts
# ensureAdminRole), so no manual SQL is needed.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
